{
  "name": "collectalytics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:harness": "VITE_DEV_HARNESS=true vite --host localhost --port 5186",
    "dev:tunnel": "CIVITAI_DEV_TUNNEL_HMR=1 vite --host localhost --port 5186 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@civitai/app-sdk": "^0.92.0",
    "@civitai/blocks-react": "^0.85.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@civitai/cli": "^0.1.150",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.23.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "description": "Collectalytics: statistics for a Civitai collection — who you collect, how often, and a stats snippet to share."
}
